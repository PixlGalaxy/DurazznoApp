# Copy this file to publisher\.env (git-ignored) and fill it in. The Publisher uploads with this account,
# so it needs write access to the two folders below.
WEBINCLOUD_USER=
WEBINCLOUD_PASSWORD=

# Optional. Defaults: the server in src\DurazznoApp\Network\WebinCloud.cs, DurazznoApp/Main and DurazznoApp/Apps
# (folders as they appear in the Webin Cloud file manager).
#WEBINCLOUD_URL=https://webincloud.itzgalaxy.com
#WEBINCLOUD_MAIN_FOLDER=DurazznoApp/Main
#WEBINCLOUD_APPS_FOLDER=DurazznoApp/Apps
