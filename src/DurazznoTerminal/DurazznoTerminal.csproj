<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Durazzno.Terminal</RootNamespace>
    <AssemblyName>DurazznoTerminal</AssemblyName>
    <Version>2.0.0</Version>
    <Product>Durazzno App</Product>
    <AssemblyTitle>Durazzno Terminal</AssemblyTitle>
    <Company>Galaxy Apps</Company>
    <ApplicationIcon>..\DurazznoApp\Assets\Logos\durazzno_icon.ico</ApplicationIcon>

    <!-- Native, self-contained and small: it must keep working when DurazznoAppDaemon.exe does not. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server address and Webin Cloud link format, shared with the app: change the server there only. -->
    <Compile Include="..\DurazznoApp\Network\WebinCloud.cs" Link="WebinCloud.cs" />
  </ItemGroup>

</Project>
