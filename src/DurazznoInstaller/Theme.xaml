<!-- Durazzno App's look (UI/Theme.xaml in the app): palette, fonts and the chamfered buttons, trimmed to what the
     installer uses. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Durazzno.UI.Controls">

    <Color x:Key="AccentColor">#F5C400</Color>
    <SolidColorBrush x:Key="WindowBg" Color="#0B0B0D" />
    <SolidColorBrush x:Key="PanelBg" Color="#151518" />
    <SolidColorBrush x:Key="PanelBorder" Color="#26262C" />
    <SolidColorBrush x:Key="Divider" Color="#1F1F24" />
    <SolidColorBrush x:Key="HoverBg" Color="#1A1A1F" />
    <SolidColorBrush x:Key="Text" Color="#F2F2F3" />
    <SolidColorBrush x:Key="TextMuted" Color="#9A9AA3" />
    <SolidColorBrush x:Key="TextDim" Color="#62626B" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentText" Color="#0B0B0D" />
    <SolidColorBrush x:Key="Success" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessChip" Color="#0F2A1A" />
    <SolidColorBrush x:Key="Warning" Color="#F97316" />
    <SolidColorBrush x:Key="WarningChip" Color="#2E1A0C" />
    <SolidColorBrush x:Key="Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerChip" Color="#2E1214" />
    <SolidColorBrush x:Key="Info" Color="#38BDF8" />

    <FontFamily x:Key="BrandFont">pack://application:,,,/DurazznoAppInstaller;component/Assets/Fonts/#RACE SPACE REGULAR 1</FontFamily>
    <FontFamily x:Key="HeadingFont">pack://application:,,,/DurazznoAppInstaller;component/Assets/Fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="CardHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <c:ChamferBorder x:Name="Chrome" Cut="8" Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </c:ChamferBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource HoverBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
