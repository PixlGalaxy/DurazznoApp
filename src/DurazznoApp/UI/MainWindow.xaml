<Window x:Class="Durazzno.UI.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Durazzno.UI.Controls"
        Title="Durazzno App"
        Width="1560" Height="1125" MinWidth="1540" MinHeight="1125"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border Grid.Row="0" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="262" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Image x:Name="BrandLogo" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="DURAZZNO APP" FontFamily="{StaticResource BrandFont}" FontSize="21" Margin="12,2,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                        <Border Background="{StaticResource Accent}" Padding="6,1,6,2" Margin="10,1,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="13"
                                       Foreground="{StaticResource AccentText}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <c:LucideIcon Icon="monitor" Width="18" Height="18" Foreground="{StaticResource TextMuted}" />
                        <TextBlock x:Name="MachineText" Margin="10,0,0,1" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold"
                                   FontSize="17" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="StatusPill" Grid.Column="2" Margin="22,0,0,0" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Margin="9,0,0,1" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"
                                       FontSize="14.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="UpdatePill" Grid.Column="4" Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="0,0,14,0"
                            VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed" Click="OnUpdatePillClick">
                        <StackPanel Orientation="Horizontal">
                            <c:LucideIcon Icon="download" Width="15" Height="15" Foreground="{StaticResource AccentText}" />
                            <TextBlock x:Name="UpdatePillText" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Style="{StaticResource WindowButton}" Tag="settings" ToolTip="Settings" AutomationProperties.Name="Settings"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnSettingsClick" />
                        <Button Style="{StaticResource WindowButton}" Tag="minus" ToolTip="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimizeClick" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Tag="square" ToolTip="Maximize"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource CloseButton}" Tag="x" ToolTip="Close to tray"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Body ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="262" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NavPanel" Margin="0,6,0,12" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Page -->
                <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PageHost" Margin="48,34,48,40" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
