<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Durazzno.UI.Controls">

    <!-- ═══ Palette ═══════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#F5C400</Color>
    <SolidColorBrush x:Key="WindowBg" Color="#0B0B0D" />
    <SolidColorBrush x:Key="SidebarBg" Color="#111113" />
    <SolidColorBrush x:Key="PanelBg" Color="#151518" />
    <SolidColorBrush x:Key="PanelBorder" Color="#26262C" />
    <SolidColorBrush x:Key="Divider" Color="#1F1F24" />
    <SolidColorBrush x:Key="HoverBg" Color="#1A1A1F" />
    <SolidColorBrush x:Key="SelectedBg" Color="#1E1E24" />
    <SolidColorBrush x:Key="Text" Color="#F2F2F3" />
    <SolidColorBrush x:Key="TextMuted" Color="#9A9AA3" />
    <SolidColorBrush x:Key="TextDim" Color="#62626B" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentChip" Color="#2B2610" />
    <SolidColorBrush x:Key="AccentText" Color="#0B0B0D" />
    <SolidColorBrush x:Key="Success" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessChip" Color="#0F2A1A" />
    <SolidColorBrush x:Key="Warning" Color="#F97316" />
    <SolidColorBrush x:Key="WarningChip" Color="#2E1A0C" />
    <SolidColorBrush x:Key="Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerChip" Color="#2E1214" />
    <SolidColorBrush x:Key="Info" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoChip" Color="#0C2230" />

    <!-- ═══ Fonts ═════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="BrandFont">pack://application:,,,/DurazznoApp;component/Assets/Fonts/#RACE SPACE REGULAR 1</FontFamily>
    <FontFamily x:Key="HeadingFont">pack://application:,,,/DurazznoApp;component/Assets/Fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ═══ Text ══════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Margin" Value="26,22,0,8" />
    </Style>

    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="CardValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="CardHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Panel header: small accent square + uppercase title, like "■ LIVE". -->
    <Style x:Key="PanelTitle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,1" />
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"
                                   FontSize="17" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="c:ChamferBorder">
        <Setter Property="Background" Value="{StaticResource PanelBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="Padding" Value="22,20,22,20" />
    </Style>

    <!-- ═══ Sidebar navigation ════════════════════════════════════════════ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" Height="50">
                        <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="26,0,12,0" VerticalAlignment="Center">
                            <c:LucideIcon x:Name="Glyph" Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Margin="16,0,0,1" VerticalAlignment="Center"
                                       FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBg}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entry that runs an action instead of opening a page (external launchers). -->
    <Style x:Key="NavAction" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" Height="50">
                        <StackPanel Orientation="Horizontal" Margin="26,0,12,0" VerticalAlignment="Center">
                            <c:LucideIcon x:Name="Glyph" Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Margin="16,0,8,1" VerticalAlignment="Center"
                                       FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="17"
                                       Foreground="{StaticResource TextMuted}" />
                            <c:LucideIcon Icon="external-link" Width="13" Height="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Buttons ═══════════════════════════════════════════════════════ -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <c:ChamferBorder x:Name="Chrome" Cut="8" Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </c:ChamferBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource HoverBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <c:LucideIcon Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" StrokeWidth="1.6"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <c:LucideIcon Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" StrokeWidth="1.6"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable tile (dashboard tool grid). -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" Padding="10,9">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Settings controls ═════════════════════════════════════════════ -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{StaticResource BodyFont}" TextElement.FontSize="13.5" />
                        <Border x:Name="Track" Grid.Column="1" Width="42" Height="22" CornerRadius="11" Margin="16,0,0,0"
                                Background="#2A2A31" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{StaticResource TextMuted}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource AccentText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{StaticResource HoverBg}" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" Padding="14,6" Margin="0,0,6,0">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{StaticResource HeadingFont}"
                                   FontWeight="SemiBold" FontSize="14.5" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentChip}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark text input (search boxes). -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{StaticResource HoverBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10,7">
                        <Grid>
                            <c:LucideIcon Icon="search" Width="15" Height="15" HorizontalAlignment="Left" Foreground="{StaticResource TextDim}" />
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="26,0,0,0" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="24,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat dark list rows (DiskMap folder list). -->
    <Style x:Key="FlatListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-10,0,0,0" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBg}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Slim dark scrollbar ═══════════════════════════════════════════ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#34343C" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#4A4A54" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,4">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,1">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
